{
    "name": "riari/laravel-forum",
    "description": "A Laravel package providing a solid foundation for building discussion forums",
    "keywords": ["laravel", "forum", "discuss"],
    "license": "MIT",
    "authors": [
        {
            "name": "Riari",
            "email": "riari@teamteatime.net"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Riari\\Forum\\": "src"
        }
    },
    "suggest": {
        "riari/laravel-forum-frontend": "The standard forum frontend that provides views written with Bootstrap 4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Riari\\Forum\\ForumServiceProvider"
            ]
        }
    }
}
